# Required: shared admin password (full access). Use 12+ characters.
APP_PASSWORD=change-me-to-a-long-password

# Optional: read-only viewer password. Must differ from APP_PASSWORD.
VIEWER_PASSWORD=

# Optional: secret for signing session cookies. If empty, one is generated
# and stored in DATA_DIR/.session-secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: club name shown in the app (default: Handball Stats)
# CLUB_NAME=HSG Schleswig

# Server
PORT=3001
HOST=0.0.0.0
# DATA_DIR=./data
# DB_PATH=./data/handball.db
# STATIC_DIR=../client/build

# Cookies / proxy
# Defaults: COOKIE_SECURE=true when NODE_ENV=production, otherwise false.
# COOKIE_SECURE=true
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=false
